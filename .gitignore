# ---------------------------------------------------------------------------
# TalentPipe backend .gitignore (Java / Maven + env files)
# (Frontend lives in the talentpipe-frontend repository)
# ---------------------------------------------------------------------------

### Environment / secrets — never commit real credentials ###
.env
.env.*
!.env.example
*.pem
*.p12
*.jks

### Java / Maven ###
backend/target/
*.class
*.jar
!backend/.mvn/wrapper/maven-wrapper.jar
*.war
hs_err_pid*
replay_pid*

### IDE / editor ###
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
.settings/
.classpath
.project
*.swp

### OS ###
.DS_Store
Thumbs.db

### Local archives / exports — never belong in source control ###
*.zip
*.tar.gz

### Logs ###
logs/
*.log
# QA evidence logs are part of the audit trail and MUST be committable
!qa/test-runs/evidence/*.log
