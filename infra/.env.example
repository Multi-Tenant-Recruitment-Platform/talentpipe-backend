# ---------------------------------------------------------------------------
# TalentPipe — example environment configuration.
#
# Copy to `.env` for docker compose, and export the backend variables in the
# shell that runs the Spring Boot app. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# --- PostgreSQL container (consumed by infra/docker-compose.yml) ---
POSTGRES_DB=talentpipe
POSTGRES_USER=talentpipe
POSTGRES_PASSWORD=talentpipe
POSTGRES_PORT=5432

# --- Backend (consumed by the Spring Boot app) ---
DB_URL=jdbc:postgresql://localhost:5432/talentpipe
DB_USERNAME=talentpipe
DB_PASSWORD=talentpipe
SERVER_PORT=8080

# HS256 JWT signing secret — REQUIRED, no default. Must be >= 32 bytes.
# Generate a strong one, e.g.:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Email (Resend) ---
# Leave RESEND_API_KEY EMPTY for local development: the backend then runs in
# console mode and writes every verification / reset / invitation link straight
# to the backend log, so all flows work without sending real mail.
#
# To send real email, put a key here and read the verified-domain caveat in the
# README: with the default onboarding@resend.dev sender, Resend only delivers to
# the address that owns the Resend account. Emailing anyone else requires a
# verified sending domain and a MAIL_FROM on that domain.
RESEND_API_KEY=
MAIL_FROM=onboarding@resend.dev

# Base URL the emailed links point at (the SPA, not the API).
FRONTEND_BASE_URL=http://localhost:5173

# --- Frontend (consumed by Vite; must be prefixed VITE_) ---
VITE_API_BASE_URL=http://localhost:8080/api/v1
