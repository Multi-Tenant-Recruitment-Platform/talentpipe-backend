# ---------------------------------------------------------------------------
# TalentPipe — example environment configuration.
#
# Copy to `.env` for docker compose, and export the backend variables in the
# shell that runs the Spring Boot app. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# --- PostgreSQL container (consumed by infra/docker-compose.yml) ---
POSTGRES_DB=talentpipe
POSTGRES_USER=talentpipe
POSTGRES_PASSWORD=talentpipe
POSTGRES_PORT=5432

# --- Backend (consumed by the Spring Boot app) ---
DB_URL=jdbc:postgresql://localhost:5432/talentpipe
DB_USERNAME=talentpipe
DB_PASSWORD=talentpipe
SERVER_PORT=8080

# HS256 JWT signing secret — REQUIRED, no default. Must be >= 32 bytes.
# Generate a strong one, e.g.:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend (consumed by Vite; must be prefixed VITE_) ---
VITE_API_BASE_URL=http://localhost:8080/api/v1
